# Generate these once the forgejo container exists (any state is fine,
# `forgejo generate secret` doesn't need an installed instance):
#   docker exec alrabeta-hub-local-forgejo-1 forgejo generate secret SECRET_KEY
#   docker exec alrabeta-hub-local-forgejo-1 forgejo generate secret INTERNAL_TOKEN
#   docker exec alrabeta-hub-local-forgejo-1 forgejo generate secret JWT_SECRET
# Copy this file to .env and fill in the generated values, then restart forgejo.

FORGEJO_SECRET_KEY=
FORGEJO_INTERNAL_TOKEN=
FORGEJO_JWT_SECRET=
