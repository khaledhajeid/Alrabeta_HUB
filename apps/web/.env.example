# Local-only values matching infra/docker-compose.yml. Copy to .env.local.

DATABASE_URL=postgres://alrabeta:localdev@localhost:5433/alrabeta
REDIS_URL=redis://localhost:6380

FORGEJO_URL=http://localhost:3300
# Generate with: openssl rand -hex 32
# Must match the secret set on each repo's push webhook (Settings → Webhooks).
FORGEJO_WEBHOOK_SECRET=

# A dedicated bot account's token (admin, so it can read every repo — see
# the README for why), not a personal one:
#   docker exec -u git alrabeta-hub-local-forgejo-1 forgejo admin user create \
#     --admin --username alrabeta-bot --email alrabeta-bot@localhost --random-password
#   docker exec -u git alrabeta-hub-local-forgejo-1 forgejo admin user generate-access-token \
#     --username alrabeta-bot --token-name worker-service --scopes "read:repository,read:user" --raw
FORGEJO_API_TOKEN=

# Better Auth. Generate a secret with: openssl rand -base64 32
# Use 127.0.0.1, not localhost — see the note in Phase 1's README section.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# Register at http://localhost:3300/user/settings/applications once logged
# in as an admin — name it, add both redirect URIs listed in the README,
# leave "Confidential client" checked.
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_CLIENT_SECRET=

# Discord Server Settings → Integrations → Webhooks → New Webhook. This URL
# is a bearer secret — anyone holding it can post to the channel. Leave
# unset to run without Discord notifications; the worker no-ops cleanly.
DISCORD_WEBHOOK_URL=
